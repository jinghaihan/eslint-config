{
  "name": "@octohash/eslint-config",
  "type": "module",
  "version": "0.1.3",
  "packageManager": "pnpm@10.29.3",
  "description": "ESLint configuration based on @antfu/eslint-config, includes built-in support for Tailwind CSS v4.",
  "author": "jinghaihan",
  "license": "MIT",
  "homepage": "https://github.com/jinghaihan/eslint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinghaihan/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/jinghaihan/eslint-config/issues"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "linter"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "test": "vitest",
    "lint": "eslint",
    "deps": "taze major -I",
    "release": "bumpp && pnpm publish --no-git-checks",
    "catalog": "pncat",
    "prepare": "npx simple-git-hooks",
    "bootstrap": "pnpm install",
    "preinstall": "npx only-allow pnpm",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@antfu/eslint-config": "catalog:lint",
    "eslint-plugin-format": "catalog:lint",
    "eslint-plugin-tailwindcss": "catalog:lint",
    "local-pkg": "catalog:prod",
    "pathe": "catalog:prod"
  },
  "devDependencies": {
    "@octohash/eslint-config": "workspace:*",
    "@octohash/tsconfig": "catalog:dev",
    "@types/eslint-plugin-tailwindcss": "catalog:types",
    "@types/node": "catalog:types",
    "bumpp": "catalog:dev",
    "eslint": "catalog:lint",
    "eslint-flat-config-utils": "catalog:lint",
    "lint-staged": "catalog:lint",
    "pncat": "catalog:dev",
    "simple-git-hooks": "catalog:dev",
    "taze": "catalog:dev",
    "tsdown": "catalog:build",
    "typescript": "catalog:dev",
    "vitest": "catalog:test"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
