{
  "name": "@octohash/eslint-config",
  "type": "module",
  "version": "0.4.0",
  "packageManager": "pnpm@11.5.1",
  "description": "Personal ESLint config based on @antfu/eslint-config with opinionated extensions.",
  "author": "jinghaihan",
  "license": "MIT",
  "homepage": "https://github.com/jinghaihan/eslint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinghaihan/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/jinghaihan/eslint-config/issues"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "linter"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "lint": "eslint",
    "deps": "taze major -I",
    "release": "bumpp",
    "catalog": "pncat",
    "prepare": "npx simple-git-hooks",
    "bootstrap": "pnpm install",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "eslint-plugin-better-tailwindcss": ">=4.2.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-better-tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@antfu/eslint-config": "catalog:lint",
    "eslint-plugin-catalogs-sort": "catalog:lint",
    "find-up-simple": "catalog:prod",
    "local-pkg": "catalog:prod",
    "pathe": "catalog:prod"
  },
  "devDependencies": {
    "tsdown": "catalog:build",
    "bumpp": "catalog:dev",
    "nano-staged": "catalog:dev",
    "pncat": "catalog:dev",
    "simple-git-hooks": "catalog:dev",
    "taze": "catalog:dev",
    "typescript": "catalog:dev",
    "eslint": "catalog:lint",
    "eslint-flat-config-utils": "catalog:lint",
    "eslint-plugin-better-tailwindcss": "catalog:lint",
    "vitest": "catalog:test",
    "@types/node": "catalog:types",
    "@octohash/eslint-config": "workspace:*"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "nano-staged": {
    "*": "eslint --fix"
  },
  "inlinedDependencies": {
    "@eslint/config-helpers": "0.5.3",
    "@eslint/core": "1.1.1",
    "@types/json-schema": "7.0.15",
    "eslint-flat-config-utils": "3.1.0"
  }
}
