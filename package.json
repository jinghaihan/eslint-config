{
  "name": "@octohash/eslint-config",
  "type": "module",
  "version": "0.1.3",
  "packageManager": "pnpm@10.29.3",
  "description": "",
  "author": "jinghaihan",
  "license": "MIT",
  "homepage": "https://github.com/jinghaihan/eslint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinghaihan/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/jinghaihan/eslint-config/issues"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "linter"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "test": "vitest",
    "lint": "eslint",
    "deps": "taze major -I",
    "release": "bumpp && pnpm publish --no-git-checks",
    "catalog": "pncat",
    "prepare": "npx simple-git-hooks",
    "bootstrap": "pnpm install",
    "preinstall": "npx only-allow pnpm",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "eslint-plugin-better-tailwindcss": ">=4.2.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-better-tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@antfu/eslint-config": "catalog:lint",
    "eslint-plugin-catalogs-sort": "catalog:lint",
    "find-up-simple": "catalog:prod",
    "local-pkg": "catalog:prod",
    "pathe": "catalog:prod",
    "tinyglobby": "catalog:prod"
  },
  "devDependencies": {
    "tsdown": "catalog:build",
    "@octohash/tsconfig": "catalog:dev",
    "bumpp": "catalog:dev",
    "pncat": "catalog:dev",
    "simple-git-hooks": "catalog:dev",
    "taze": "catalog:dev",
    "typescript": "catalog:dev",
    "eslint": "catalog:lint",
    "eslint-flat-config-utils": "catalog:lint",
    "eslint-plugin-better-tailwindcss": "catalog:lint",
    "lint-staged": "catalog:lint",
    "vitest": "catalog:test",
    "@types/node": "catalog:types",
    "@octohash/eslint-config": "workspace:*"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
